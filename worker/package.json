{
  "name": "toiaf-live-autopost",
  "version": "0.1.0",
  "private": true,
  "description": "TOiAF stream.npntoi LIVE auto-post control plane: Cloudflare Worker + D1 + Queues",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply toiaf_live_autopost --local",
    "migrate:remote": "wrangler d1 migrations apply toiaf_live_autopost --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.95.0"
  }
}
